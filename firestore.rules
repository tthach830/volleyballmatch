rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{document=**} {
      allow read, write: if true;
    }
    match /games/{document=**} {
      allow read, write: if true;
    }
    match /availabilitySlots/{document=**} {
      allow read, write: if true;
    }
    match /tournaments/{document=**} {
      allow read, write: if true;
    }
  }
}
